---
export interface Props {
	testimonials?: { text: string; name: string }[];
	name: string;
	image: string;
	bioLines: string[];
}

const { testimonials = [], name, image, bioLines } = Astro.props;
const visibleTestimonials = testimonials.slice(0, 3);
---

{visibleTestimonials.length > 0 && (
	<section class="testimonials-section" id="testimonials">
		<div class="container">
			<h2 class="section-title">Ils m'ont fait confiance</h2>
			<div class="testimonials-grid">
				{visibleTestimonials.map((testimonial) => (
					<blockquote class="testimonial-card">
						<p>{testimonial.text}</p>
						<footer>{testimonial.name}</footer>
					</blockquote>
				))}
			</div>
		</div>
	</section>
)}

<section class="author-section" id="qui-suis-je">
	<div class="container author-content">
		<img class="author-image" src={image} alt={`Portrait de ${name}`} loading="lazy" />
		<div>
			<h2 class="section-title">Qui suis-je</h2>
			<p class="author-name">{name}</p>
			{bioLines.slice(0, 3).map((line) => <p class="author-line">{line}</p>)}
		</div>
	</div>
</section>

<style>
	.testimonials-section,
	.author-section {
		padding: clamp(48px, 7vw, 80px) 0;
		border-top: 1px solid var(--color-border);
	}

	.testimonials-section {
		background: var(--color-surface);
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 var(--content-padding);
	}

	.section-title {
		margin-bottom: calc(var(--grid-unit) * 5);
		color: var(--color-accent);
		font-family: var(--font-heading-secondary);
		font-size: 2rem;
		text-align: center;
		text-transform: uppercase;
	}

	.testimonials-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: calc(var(--grid-unit) * 2);
	}

	.testimonial-card {
		margin: 0;
		padding: calc(var(--grid-unit) * 3);
		border: 1px solid var(--color-border);
		border-top: 3px solid var(--color-accent);
		background: var(--color-background);
	}

	.testimonial-card p {
		margin-bottom: calc(var(--grid-unit) * 2);
		color: var(--color-text-secondary);
		line-height: 1.6;
	}

	.testimonial-card footer {
		color: var(--color-text-primary);
		font-weight: 700;
	}

	.author-content {
		display: grid;
		grid-template-columns: 160px minmax(0, 1fr);
		align-items: center;
		gap: calc(var(--grid-unit) * 5);
		max-width: 880px;
	}

	.author-image {
		width: 160px;
		aspect-ratio: 1;
		margin: 0;
		border: 4px solid var(--color-accent);
		border-radius: 50%;
		object-fit: cover;
	}

	.author-section .section-title {
		margin-bottom: calc(var(--grid-unit) * 2);
		text-align: left;
	}

	.author-name {
		margin-bottom: calc(var(--grid-unit) * 1.5);
		color: var(--color-text-primary);
		font-family: var(--font-heading-secondary);
		font-weight: 700;
	}

	.author-line {
		margin: 0 0 calc(var(--grid-unit) / 2);
		color: var(--color-text-secondary);
	}

	@media (max-width: 600px) {
		.author-content {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.author-section .section-title {
			text-align: center;
		}
	}
</style>