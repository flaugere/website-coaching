---
import Layout from '../components/Layout.astro';

const recentPosts = await Astro.glob('../content/blog/*.md');
const sortedPosts = recentPosts
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3);
---

<Layout title="Accueil" description="Accompagnements personnalisés, plans d'entraînement et conseils en nutrition." showSidebar={false}>
  <div class="landing-page">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1 class="hero-title">Coach sportif</h1>
        <p class="hero-subtitle">Fitness | Santé | Préparation Trail</p>
        <p class="hero-description">
          Accompagnements personnalisés, plans d'entraînement et conseils en nutrition.
        </p>
        <hr class="hero-rule" />
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">C'est parti !</a>
          <a href="#coaching" class="btn btn-secondary">Coaching</a>
          <a href="/trail" class="btn btn-secondary">Préparation trail</a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features" id="features">
      <div class="container">
        <h2 class="section-title">Ma philosophie</h2>
        <div class="features-grid">
          <div class="feature-card">
            <h3 class="feature-title">Corps sain</h3>
            <p class="feature-description">
              Pour contrer les effets néfastes de la sédentarité, l'activité physique est centrale.
            </p>
            <p class="feature-description">
              L'OMS recommande au moins 150 minutes d'activité modérée (ou 75 minutes d'activité soutenue) et 2 séances de renforcement musculaire par semaine.
            </p>
          </div>
          <div class="feature-card">
            <h3 class="feature-title">Esprit sain</h3>
            <p class="feature-description">
              L'exercice régulier régule les hormones, réduit le stress et renforce la résilience mentale. Un vrai pilier pour garder un esprit clair et serein.
            </p>
          </div>
          <div class="feature-card">
            <h3 class="feature-title">Alimentation</h3>
            <p class="feature-description">
              L'alimentation est le carburant de ton corps et de ton esprit. C'est une composante indissociable de ton bien-être physique et de tes performances.
            </p>
          </div>
          <div class="feature-card">
            <h3 class="feature-title">Minimalisme</h3>
            <p class="feature-description">
              Ancrons des habitudes durables avec une approche progressive et efficiente. À la maison, en salle ou en extérieur.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Blog Section -->
    <section class="demo-section" id="demo">
      <div class="container">
        <h2 class="section-title">Blog</h2>
        <p class="demo-description">
          Retrouve mes conseils, retours d'expérience et ressources sur le renforcement, la nutrition et la préparation physique.
        </p>
        {sortedPosts.length > 0 && (
          <div class="demo-posts">
            {sortedPosts.map(post => (
              <article class="demo-post-card">
                <h3 class="demo-post-title">
                  <a href={`/blog/${post.file.split('/').pop()?.replace('.md', '')}`}>{post.frontmatter.title}</a>
                </h3>
                
                <time class="demo-post-date" datetime={post.frontmatter.date}>
                  {new Date(post.frontmatter.date).toLocaleDateString('fr-FR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                
                {post.frontmatter.excerpt && (
                  <p class="demo-post-excerpt">{post.frontmatter.excerpt}</p>
                )}
                
                {post.frontmatter.categories && (
                  <div class="demo-post-categories">
                    {post.frontmatter.categories.map((category) => (
                      <span class="demo-category">{category}</span>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        )}
        
        <div class="demo-actions">
          <a href="/blog" class="btn btn-primary">Voir tous les articles</a>
        </div>
      </div>
    </section>

    <!-- Coaching Section -->
    <section class="coaching" id="coaching">
      <div class="container">
        <h2 class="section-title">Coaching fitness & trail</h2>
        <div class="install-steps">
          <div class="step">
            <h3 class="step-number">01</h3>
            <div class="step-content">
              <h4 class="step-title">La rencontre</h4>
              <p class="step-description">Nous échangeons sur tes objectifs, ton rythme de vie et tes contraintes pour définir un cadre sur mesure, complété par un bilan de forme initial.</p>
            </div>
          </div>
          
          <div class="step">
            <h3 class="step-number">02</h3>
            <div class="step-content">
              <h4 class="step-title">Le démarrage</h4>
              <p class="step-description">À partir de notre échange, je te propose un suivi adapté : planification, séances guidées et conseils nutritionnels (avec séance d'essai possible en présentiel).</p>
            </div>
          </div>
          
          <div class="step">
            <h3 class="step-number">03</h3>
            <div class="step-content">
              <h4 class="step-title">L'accompagnement</h4>
              <p class="step-description">Un suivi individuel continu nous permet d'ajuster la programmation selon tes contraintes personnelles, professionnelles ou ta fatigue du moment.</p>
            </div>
          </div>
          <div class="coaching-actions">
            <a href="/contact" class="btn btn-primary">C'est parti !</a>  
          </div>
        </div>
      </div>
    </section>

    <!-- Trail Coaching Section -->
    <section class="trail-coaching" id="coaching-trail">
      <div class="container trail-coaching-content">
        <div>
          <p class="trail-coaching-eyebrow">Coaching spécifique</p>
          <h2 class="section-title">Renforcement trail</h2>
          <p class="trail-coaching-description">
            Prépare ton corps et ton mental pour les sentiers grâce à un renforcement ciblé et adapté à tes courses d'objectif.
          </p>
        </div>
        <a href="/trail" class="btn btn-primary">Découvrir le coaching trail</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .landing-page {
    width: 100%;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .hero {
    text-align: center;
    position: relative;
    isolation: isolate;
    padding: clamp(96px, 14vw, 168px) 0 clamp(72px, 10vw, 112px);
    background:
      url('/images/background_salle.jpg'),
      linear-gradient(135deg, var(--color-surface) 0%, var(--color-background) 100%);
    background-size: cover;
    background-position: center 42%;
    background-repeat: no-repeat;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .hero-title {
    font-family: var(--font-heading-primary);
    font-size: clamp(3.25rem, 8vw, 6rem);
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 0.95;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .hero-subtitle {
    font-family: var(--font-heading-secondary);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: calc(var(--grid-unit) * 3);
  }

  .hero-description {
    font-size: 1.375rem;
    line-height: 1.6;
    color: var(--color-text-primary);
    margin-bottom: calc(var(--grid-unit) * 4);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-rule {
    height: 3px;
    background-color: var(--color-accent);
    border: none;
    width: 96px;
    margin: 0 auto calc(var(--grid-unit) * 4);
  }

  .hero-actions {
    display: flex;
    gap: calc(var(--grid-unit) * 2);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    font-family: var(--font-heading-secondary);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: calc(var(--grid-unit) * 1.5) calc(var(--grid-unit) * 3);
    border-radius: 2px;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    text-decoration: none;
    display: inline-block;
    font-size: 0.95rem;
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: white;
    border: 2px solid var(--color-accent);
  }

  .btn-primary:hover,
  .btn-primary:focus {
    background-color: transparent;
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-text-primary);
    border: 2px solid var(--color-border);
  }

  .btn-secondary:hover,
  .btn-secondary:focus {
    background-color: var(--color-text-primary);
    color: white;
    transform: translateY(-2px);
  }

  .features {
    padding: clamp(64px, 9vw, 112px) 0;
  }

  .section-title {
    font-family: var(--font-heading-secondary);
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    font-weight: 900;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: calc(var(--grid-unit) * 5);
    text-align: center;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .feature-card {
    background-color: var(--color-background);
    padding: clamp(24px, 4vw, 40px);
    border: 0;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .feature-card:hover {
    background-color: #fff8ed;
  }

  .feature-title {
    font-family: var(--font-heading-secondary);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: calc(var(--grid-unit) * 1.5);
    display: flex;
    align-items: center;
    gap: var(--grid-unit);
  }

  .feature-title::before {
    content: '';
    width: 24px;
    height: 3px;
    flex: 0 0 auto;
    background-color: var(--color-accent);
  }

  .feature-description {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 calc(var(--grid-unit) * 1.5) 0;
  }

  .feature-description:last-child {
    margin-bottom: 0;
  }

  .demo-section {
    padding: clamp(64px, 9vw, 112px) 0;
    border-top: 1px solid var(--color-border);
  }

  .demo-description {
    text-align: center;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: calc(var(--grid-unit) * 6);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .demo-posts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(var(--grid-unit) * 2);
    margin-bottom: calc(var(--grid-unit) * 6);
  }

  .demo-post-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: 2px;
    padding: calc(var(--grid-unit) * 3) calc(var(--grid-unit) * 2.5);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .demo-post-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .demo-post-title {
    font-family: var(--font-heading-secondary);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: calc(var(--grid-unit));
  }

  .demo-post-title a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .demo-post-title a:hover,
  .demo-post-title a:focus {
    color: var(--color-accent);
  }

  .demo-post-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: calc(var(--grid-unit) * 1.5);
  }

  .demo-post-excerpt {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .demo-post-categories {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--grid-unit) / 2);
  }

  .demo-category {
    background-color: var(--color-text-primary);
    color: white;
    padding: calc(var(--grid-unit) / 4) calc(var(--grid-unit) / 2);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
  }

  .demo-actions {
    text-align: center;
  }

  .coaching {
    padding: clamp(64px, 9vw, 112px) 0;
    background-color: var(--color-text-primary);
    color: var(--color-background);
  }

  .coaching .step-description {
    color: rgba(255, 255, 255, 0.78);
  }

  .coaching .step-title {
    color: var(--color-background);
  }

  .coaching-actions {
    display: flex;
    justify-content: center;
    margin-top: calc(var(--grid-unit) * 4);
  }

  .trail-coaching {
    padding: clamp(48px, 7vw, 80px) 0;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .trail-coaching-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--grid-unit) * 4);
  }

  .trail-coaching .section-title {
    margin-bottom: calc(var(--grid-unit) * 1.5);
    text-align: left;
  }

  .trail-coaching-eyebrow {
    margin-bottom: var(--grid-unit);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .trail-coaching-description {
    max-width: 620px;
    margin-bottom: 0;
    color: var(--color-text-secondary);
  }

  .install-steps {
    max-width: 880px;
    margin: 0 auto;
    display: grid;
    gap: 0;
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: calc(var(--grid-unit) * 2);
    align-items: start;
    padding: calc(var(--grid-unit) * 3) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }

  .step:nth-of-type(3) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  }

  .step-number {
    font-family: var(--font-heading-primary);
    font-size: 3rem;
    font-weight: 900;
    color: var(--color-accent);
    margin: 0;
  }

  .step-content {
    display: flex;
    flex-direction: column;
  }

  .step-title {
    font-family: var(--font-heading-secondary);
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: calc(var(--grid-unit));
  }

  .step-description {
    margin-bottom: 0;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 3rem;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }

    .hero-description {
      font-size: 1.125rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: center;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .demo-posts {
      grid-template-columns: 1fr;
    }

    .trail-coaching-content {
      align-items: flex-start;
      flex-direction: column;
    }

    .step {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .step-number {
      font-size: 2rem;
    }
  }
</style>